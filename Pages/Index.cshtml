@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<section class="hero">
    <div class="hero-content">
        
        <img src="~/images/logo.jpg"
        alt="Bryant's Son Home Improvement Logo"
        class="hero-logo" />
        <h1>Bryant's Son Home Improvement, LLC</h1>
        <p>Reliable remodeling, repairs, and home improvement services.</p>
        <a class="btn-primary" href="#services">View Services</a>
    </div>
</section>

<section id="services" class="services">
    <h2>Our Services</h2>

    <div class="service-grid">
        <div class="service-card">Remodeling</div>
        <div class="service-card">Decks</div>
        <div class="service-card">Tile</div>
        <div class="service-card">Painting</div>
        <div class="service-card">Framing</div>
        <div class="service-card">Siding</div>
        <div class="service-card">Drywall</div>
        <div class="service-card">Cabinets</div>
        <div class="service-card">Demo</div>
    </div>
</section>

<section class="services">
    <h2>Why Choose Us?</h2>

    <div class="service-grid">
        <div class="service-card">Licensed & Insured</div>
        <div class="service-card">Quality Craftsmanship</div>
        <div class="service-card">Free Estimates</div>
        <div class="service-card">Customer Satisfaction</div>
    </div>
</section>

<section class="services">
    <h2>Contact Us</h2>

    <p><strong>Phone:</strong> (270) 300-6314</p>
    <p><strong>Email:</strong> Bryantsson@gmail.com</p>
    <p><strong>Location:</strong> Rineyville, Kentucky</p>
</section>